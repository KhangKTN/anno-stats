{
    "name": "Anno Stats",
    "manifest_version": 3,
    "version": "1.0.0",
    "description": "Support for tracking the number of annotated tags.",
    "permissions": ["storage"],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    },
    "host_permissions": ["https://ado.treed.ai/"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://ado.treed.ai/"],
            "js": ["page-hook.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://ado.treed.ai/"],
            "js": ["bridge.js"],
            "run_at": "document_start",
            "world": "ISOLATED"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
